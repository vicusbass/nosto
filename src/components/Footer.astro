---
import { Icon } from 'astro-icon/components';
import footerLogo from '../assets/footer-logo.svg';
import { Image } from 'astro:assets';
import contact from '../config/contact';

const isContactPage = Astro.url.pathname === '/contact' || Astro.url.pathname === '/contact/';
---

<footer class="footer py-8">
  <div class="mx-auto px-4 md:px-6 lg:px-16">
    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-8">
      <div class="flex flex-row gap-8 items-start">
        <div>
          <Image src={footerLogo} alt="Logo Nosto" class="h-24 w-auto" />
        </div>
        <div class="flex flex-col gap-3 text-white">
          <p class="flex items-center gap-2">
            <Icon name="mdi:phone" class="h-5 w-5" />
            <a href={`tel:${contact.phone}`}>{contact.phone}</a>
          </p>
          <p class="flex items-center gap-2">
            <Icon name="mdi:email" class="h-5 w-5" />
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
          <p class="flex items-center gap-2">
            <Icon name="mdi:map-marker" class="h-5 w-5" />
            <a href={contact.address} target="_blank" rel="noopener noreferrer">
              {contact.addressText}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <Icon name="mdi:cookie-cog-outline" class="h-5 w-5" />
            <button type="button" data-cookie-settings class="cursor-pointer hover:underline">
              Setări cookie
            </button>
          </p>
          <div class="flex items-center gap-4 pt-1">
            <a
              href={contact.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Nosto pe Facebook"
              class="transition-colors duration-300 hover:text-[var(--color-main-btn)]"
            >
              <Icon name="mdi:facebook" class="h-6 w-6" />
            </a>
            <a
              href={contact.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Nosto pe Instagram"
              class="transition-colors duration-300 hover:text-[var(--color-main-btn)]"
            >
              <Icon name="mdi:instagram" class="h-6 w-6" />
            </a>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-start md:justify-end mt-6 md:mt-0">
        <div class="flex flex-wrap md:flex-nowrap gap-4">
          <a href="/contact" class="btn-primary">Contact</a>
          <a href="/apartamente" class="btn-primary hidden md:inline-flex">Apartamente A</a>
          <a href="/apartamente-b" class="btn-primary hidden md:inline-flex">Apartamente B</a>
          <a href={`tel:${contact.phone}`} class="btn-primary">Sună acum</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile sticky CTA buttons -->
  <div
    class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white border-t border-gray-200 shadow-lg p-4"
  >
    <div class="flex gap-2">
      <a href="/apartamente" class="flex-1 btn-secondary text-center px-2">Corp A</a>
      <a href="/apartamente-b" class="flex-1 btn-secondary text-center px-2">Corp B</a>
      <a
        href={isContactPage ? `tel:${contact.phone}` : '/contact'}
        class="flex-1 btn-primary text-center px-2"
      >
        {isContactPage ? 'Sună acum' : 'Contact'}
      </a>
    </div>
  </div>
</footer>
