---
import { Icon } from 'astro-icon/components';
import video from '../config/video';

interface Props {
  videoId?: string;
  title?: string;
}

const { videoId = video.youtubeId, title = video.title } = Astro.props;

// YouTube's own thumbnails, so the poster always matches whatever video is
// set. Not every upload has the 1280px `maxresdefault`; for those YouTube
// answers with a 404 whose body is a 120×90 grey placeholder (so `onerror`
// alone does not fire), and the inline handlers fall back to `hqdefault`,
// which always exists.
const poster = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
const swapToFallback = `if(this.src!==this.dataset.fallback)this.src=this.dataset.fallback`;
---

<div
  class="youtube-facade relative w-full aspect-video overflow-hidden rounded-lg shadow-lg bg-[var(--color-text-body)]"
>
  <button
    type="button"
    class="group absolute inset-0 h-full w-full cursor-pointer"
    data-youtube-play={videoId}
    data-youtube-title={title}
    aria-label={`Redă: ${title}`}
  >
    <img
      src={poster}
      data-fallback={posterFallback}
      onload={`if(this.naturalWidth<=120){${swapToFallback}}`}
      onerror={swapToFallback}
      alt=""
      loading="lazy"
      decoding="async"
      width="1280"
      height="720"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
    />
    <span
      class="absolute left-1/2 top-1/2 flex h-16 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-tr-2xl bg-[var(--color-main-btn)] text-white shadow-lg transition-colors duration-300 group-hover:bg-[var(--color-main-btn-hover)] group-focus-visible:bg-[var(--color-main-btn-hover)] md:h-20 md:w-24"
    >
      <Icon name="mdi:play" class="h-10 w-10 md:h-12 md:w-12" />
    </span>
  </button>
</div>

<script>
  // Click-to-play: the YouTube player (about 1 MB of scripts, plus YouTube's
  // storage) loads only after the visitor asks for it. One listener on
  // `document` covers every player and survives ClientRouter page swaps,
  // because the document persists and this module runs only once.
  document.addEventListener('click', (e) => {
    const button =
      e.target instanceof Element
        ? e.target.closest<HTMLButtonElement>('button[data-youtube-play]')
        : null;
    if (!button) return;

    const params = new URLSearchParams({
      autoplay: '1',
      // Suggest only videos from the same channel when playback ends.
      rel: '0',
      playsinline: '1',
      // Player controls in Romanian, matching the site, whatever the
      // visitor's browser language.
      hl: 'ro',
    });
    const iframe = document.createElement('iframe');
    // Privacy-enhanced domain: no tracking cookies until the video is played,
    // and by now the visitor has asked for exactly that.
    iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.youtubePlay}?${params}`;
    iframe.title = button.dataset.youtubeTitle ?? 'YouTube video';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    // YouTube refuses to play embeds that arrive without a referrer
    // ("Error 153"), so do not leave this to the page's default policy.
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'absolute inset-0 h-full w-full';

    button.replaceWith(iframe);
    iframe.focus();
  });
</script>
