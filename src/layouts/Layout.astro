---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import contact from '../config/contact';
import headerLogo from '../assets/header-logo.svg';
import { toJsonLd } from '../utils/jsonLd';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  /** Keep the page out of search engines (e.g. the thank-you page). */
  noindex?: boolean;
  /**
   * LCP image to preload. Without this the hero is only discovered once the
   * render-blocking CSS has landed, which on mobile left it waiting ~563ms
   * before its request even started.
   */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
  /**
   * Load GTM and the Meta Pixel straight away instead of on first interaction.
   * For pages whose only job is to be measured (the thank-you page carries the
   * Google Ads lead conversion), where a visitor may read and leave untouched.
   */
  eagerTags?: boolean;
}

const {
  title,
  description,
  image,
  url,
  noindex = false,
  preloadImage,
  eagerTags = false,
} = Astro.props;

const defaultDescription =
  'Proiect NOU in TIMIȘOARA, vânzare direct de la dezvoltator, apartamente cu finisaje moderne si de calitate, preturi competitive, zonă liniștită si verde preponderent rezidențiala.';
const defaultImage = new URL('/og.jpg', Astro.url).href;
const canonicalURL = url || Astro.url.href;
const ogImage = image ? new URL(image, Astro.url).href : defaultImage;

const siteUrl = Astro.site ?? Astro.url;
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': new URL('/#organization', siteUrl).href,
  name: 'Nosto - Proiect Rezidential',
  url: siteUrl.href,
  logo: new URL(headerLogo.src, siteUrl).href,
  image: defaultImage,
  telephone: contact.phoneInternational,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.streetAddress,
    addressLocality: 'Timișoara',
    addressRegion: 'Timiș',
    addressCountry: 'RO',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.75216,
    longitude: 21.2759468,
  },
  sameAs: Object.values(contact.social),
};
---

<!doctype html>
<html lang="ro" data-eager-tags={eagerTags || undefined}>
  <head>
    <meta charset="UTF-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description || defaultDescription} />
    <link rel="canonical" href={canonicalURL} />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.imagesrcset}
          imagesizes={preloadImage.imagesizes}
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || defaultDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Nosto - Proiect Rezidential" />

    <meta name="theme-color" content="#c56d44" />
    <meta
      property="og:image:alt"
      content="Proiect Rezidential Nosto - Apartamente moderne în Timișoara"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || defaultDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO meta tags -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="geo.region" content="RO-TM" />
    <meta name="geo.placename" content="Timișoara" />
    <meta name="geo.position" content="45.75216;21.2759468" />
    <meta name="ICBM" content="45.75216, 21.2759468" />
    <meta name="author" content="Nosto Development" />
    <meta
      name="keywords"
      content="apartamente timisoara, proiect rezidential, apartamente noi, vanzare apartamente, dezvoltator imobiliar, finisaje moderne, preturi competitive, zona verde, timisoara rezidential"
    />
    <meta name="copyright" content="Nosto Development" />
    <ClientRouter />

    <!-- Business schema -->
    <script type="application/ld+json" is:inline set:html={toJsonLd(businessSchema)} />
    <!-- Third-party tag loading -->
    <script is:inline>
      // GTM and the Meta Pixel are both loaded on first interaction rather than
      // during page load. Their bytes and parse cost are not ours to change --
      // only when we pay them. Deferring to idle instead puts that work inside
      // Lighthouse's TBT window (FCP -> TTI), which on 4x-throttled mobile CPU
      // costs more than the deferral saves.
      //
      // `pointerdown` fires before `click`, so clicking a link or a button counts
      // as engagement and the tags load. A visitor who leaves without touching
      // anything is not recorded -- the accepted trade for the score.
      //
      // Two exceptions load the tags immediately:
      // - pages rendered with `eagerTags` (the thank-you page, whose page view
      //   *is* the Google Ads conversion);
      // - landings from an ad (gclid/gbraid/wbraid/fbclid/utm_* in the URL).
      //   The tags read the click id from the address bar, and if the first
      //   interaction is a tap on an internal link, the ClientRouter swaps the
      //   URL before gtm.js runs and the click can no longer be attributed.
      //   Lab tests never carry these parameters, so the score is unaffected.
      (function (w) {
        var triggers = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        var pending = [];
        var fired = false;

        function run() {
          if (fired) return;
          fired = true;
          triggers.forEach(function (type) {
            w.removeEventListener(type, run);
          });
          while (pending.length) pending.shift()();
        }

        triggers.forEach(function (type) {
          w.addEventListener(type, run, { passive: true });
        });

        w.__onFirstInteraction = function (callback) {
          fired ? callback() : pending.push(callback);
        };

        if (
          w.document.documentElement.hasAttribute('data-eager-tags') ||
          /[?&](gclid|gbraid|wbraid|fbclid|utm_[a-z]+)=/i.test(w.location.search)
        ) {
          run();
        }
      })(window);
    </script>

    <!-- Consent defaults (Google Consent Mode v2, advanced) -->
    <script is:inline>
      // Must run before GTM: the consent default has to be on the dataLayer
      // ahead of the `gtm.js` event. Nothing is granted until the visitor
      // chooses in the banner (src/scripts/consent.ts); denied Google tags still
      // send cookieless pings, which Google uses to model conversions.
      // A returning visitor's stored choice is read straight from the banner's
      // `cc_cookie`, so their tags start with the right consent and the banner
      // code itself never has to load for them.
      (function (w, d) {
        var stored = null;
        try {
          var m = d.cookie.match(/(?:^|;\s*)cc_cookie=([^;]+)/);
          if (m) stored = JSON.parse(decodeURIComponent(m[1])).categories || [];
        } catch (e) {}
        var cats = stored || [];
        w.__consent = {
          stored: !!stored,
          analytics: cats.indexOf('analytics') > -1,
          marketing: cats.indexOf('marketing') > -1,
        };
        var state = function (granted) {
          return granted ? 'granted' : 'denied';
        };

        // Google's canonical gtag stub, defined synchronously. Calls made
        // before gtm.js lands queue on the dataLayer and are replayed once it
        // loads, instead of being dropped by a `typeof gtag` guard.
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () {
          w.dataLayer.push(arguments);
        };
        w.gtag('consent', 'default', {
          analytics_storage: state(w.__consent.analytics),
          ad_storage: state(w.__consent.marketing),
          ad_user_data: state(w.__consent.marketing),
          ad_personalization: state(w.__consent.marketing),
          functionality_storage: 'granted',
          security_storage: 'granted',
        });
        w.gtag('set', 'ads_data_redaction', true);
      })(window, document);
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

        w.__onFirstInteraction(function () {
          var j = d.createElement('script');
          j.async = true;
          j.src =
            'https://www.googletagmanager.com/gtm.js?id=' + i + (l != 'dataLayer' ? '&l=' + l : '');
          d.head.appendChild(j);
        });

        // Lead-intent clicks, pushed as dataLayer events for GTM to forward to
        // GA4 and Google Ads. One listener on `document` covers every link on
        // every page, including ones in Sanity content, and survives
        // ClientRouter swaps (the document persists; only its body changes).
        // The `pointerdown` before the click has already started loading
        // gtm.js; the push waits on the dataLayer until it runs. Phone links
        // keep the page open and WhatsApp opens a new tab, so nothing unloads
        // the page before then.
        d.addEventListener('click', function (e) {
          var a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var event = /^tel:/i.test(href)
            ? 'phone_click'
            : /^https?:\/\/(wa\.me|api\.whatsapp\.com)\//i.test(href)
              ? 'whatsapp_click'
              : /^mailto:/i.test(href)
                ? 'email_click'
                : null;
          if (!event) return;
          w[l].push({
            event: event,
            link_section: a.closest('footer')
              ? 'footer'
              : a.closest('header, nav')
                ? 'header'
                : 'content',
          });
        });
      })(window, document, 'dataLayer', 'GTM-W3KX76MD');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Meta Pixel Code -->
    <script is:inline>
      // Meta's own snippet, with two changes: the `fbq` stub and the queued
      // init/PageView stay synchronous (so no event is lost), while fbevents.js
      // itself waits for the first interaction; and consent is declared before
      // `init`, so nothing is sent to Meta until marketing cookies are accepted
      // (the banner grants it later via fbq('consent', 'grant')).
      !(function (f, b, e, v) {
        if (f.fbq) return;
        var n = (f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        });
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];

        f.__onFirstInteraction(function () {
          var t = b.createElement(e);
          t.async = !0;
          t.src = v;
          var s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        });
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('consent', window.__consent.marketing ? 'grant' : 'revoke');
      fbq('init', '714838384770271');
      fbq('track', 'PageView');
    </script>
    <!-- End Meta Pixel Code -->
  </head>
  <body class="font-sans flex flex-col min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W3KX76MD"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=714838384770271&ev=PageView&noscript=1"
      /></noscript
    >
    <svg
      aria-hidden="true"
      width="0"
      height="0"
      style="position:absolute;width:0;height:0;overflow:hidden"
    >
      <defs>
        <pattern
          id="apartment-sold-stripes"
          patternUnits="userSpaceOnUse"
          width="8"
          height="8"
          patternTransform="rotate(45)"
        >
          <rect width="8" height="8" style="fill: var(--color-bg-primary);"></rect>
          <path
            d="M0 0 L0 8"
            style="stroke: var(--color-tab-secondary); stroke-width: 2; opacity: 0.4;"></path>
          <path
            d="M4 0 L4 8"
            style="stroke: var(--color-tab-secondary); stroke-width: 2; opacity: 0.4;"></path>
        </pattern>
      </defs>
    </svg>
    <Navbar transition:persist />
    <main class="pt-16 flex-grow mb-16 pb-16 md:pb-0">
      <slot />
    </main>
    <Footer transition:persist />

    <script>
      // Cookie banner, loaded on demand so it costs nothing at page load: on the
      // first interaction for visitors who have not chosen yet (the same moment
      // the tags load), or whenever a `[data-cookie-settings]` control is
      // clicked. Bundled scripts run once per full page load, and the listener
      // sits on `document`, so it survives ClientRouter navigations.
      const loadConsent = () => import('../scripts/consent');

      if (!window.__consent.stored) {
        window.__onFirstInteraction(() => {
          loadConsent().then((consent) => consent.start());
        });
      }

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-cookie-settings]')) {
          return;
        }
        event.preventDefault();
        loadConsent().then((consent) => consent.showPreferences());
      });
    </script>
  </body>
</html>
