---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import contact from '../config/contact';
import headerLogo from '../assets/header-logo.svg';
import { toJsonLd } from '../utils/jsonLd';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  /** Keep the page out of search engines (e.g. the thank-you page). */
  noindex?: boolean;
  /**
   * LCP image to preload. Without this the hero is only discovered once the
   * render-blocking CSS has landed, which on mobile left it waiting ~563ms
   * before its request even started.
   */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
}

const { title, description, image, url, noindex = false, preloadImage } = Astro.props;

const defaultDescription =
  'Proiect NOU in TIMIȘOARA, vânzare direct de la dezvoltator, apartamente cu finisaje moderne si de calitate, preturi competitive, zonă liniștită si verde preponderent rezidențiala.';
const defaultImage = new URL('/og.jpg', Astro.url).href;
const canonicalURL = url || Astro.url.href;
const ogImage = image ? new URL(image, Astro.url).href : defaultImage;

const siteUrl = Astro.site ?? Astro.url;
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': new URL('/#organization', siteUrl).href,
  name: 'Nosto - Proiect Rezidential',
  url: siteUrl.href,
  logo: new URL(headerLogo.src, siteUrl).href,
  image: defaultImage,
  telephone: contact.phoneInternational,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.streetAddress,
    addressLocality: 'Timișoara',
    addressRegion: 'Timiș',
    addressCountry: 'RO',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.75216,
    longitude: 21.2759468,
  },
  sameAs: Object.values(contact.social),
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description || defaultDescription} />
    <link rel="canonical" href={canonicalURL} />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.imagesrcset}
          imagesizes={preloadImage.imagesizes}
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || defaultDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Nosto - Proiect Rezidential" />

    <meta name="theme-color" content="#c56d44" />
    <meta
      property="og:image:alt"
      content="Proiect Rezidential Nosto - Apartamente moderne în Timișoara"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || defaultDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO meta tags -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="geo.region" content="RO-TM" />
    <meta name="geo.placename" content="Timișoara" />
    <meta name="geo.position" content="45.75216;21.2759468" />
    <meta name="ICBM" content="45.75216, 21.2759468" />
    <meta name="author" content="Nosto Development" />
    <meta
      name="keywords"
      content="apartamente timisoara, proiect rezidential, apartamente noi, vanzare apartamente, dezvoltator imobiliar, finisaje moderne, preturi competitive, zona verde, timisoara rezidential"
    />
    <meta name="copyright" content="Nosto Development" />
    <ClientRouter />

    <!-- Business schema -->
    <script type="application/ld+json" is:inline set:html={toJsonLd(businessSchema)} />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-W3KX76MD');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Meta Pixel Code -->
    <script is:inline>
      // Meta's own snippet, with one change: the `fbq` stub and the queued
      // init/PageView stay synchronous (so no event is lost), but fbevents.js
      // itself — ~111 KiB on a 20-minute TTL we do not control — is fetched only
      // once the visitor interacts.
      //
      // Interaction is the trigger on purpose, with no idle or timeout fallback.
      // An idle fallback put the library's parse/execute inside Lighthouse's TBT
      // window (FCP → TTI), which on 4x-throttled mobile CPU cost more score than
      // the deferral saved. `pointerdown` also covers clicking a link, so anyone
      // who actually engages is still recorded; a visitor who bounces without
      // touching anything is not.
      !(function (f, b, e, v) {
        if (f.fbq) return;
        var n = (f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        });
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];

        var triggers = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        var requested = false;

        function load() {
          if (requested) return;
          requested = true;
          triggers.forEach(function (type) {
            f.removeEventListener(type, load);
          });
          var t = b.createElement(e);
          t.async = !0;
          t.src = v;
          var s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        }

        triggers.forEach(function (type) {
          f.addEventListener(type, load, { passive: true });
        });
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '714838384770271');
      fbq('track', 'PageView');
    </script>

    <!-- End Meta Pixel Code -->
  </head>
  <body class="font-sans flex flex-col min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W3KX76MD"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=714838384770271&ev=PageView&noscript=1"
      /></noscript
    >
    <svg
      aria-hidden="true"
      width="0"
      height="0"
      style="position:absolute;width:0;height:0;overflow:hidden"
    >
      <defs>
        <pattern
          id="apartment-sold-stripes"
          patternUnits="userSpaceOnUse"
          width="8"
          height="8"
          patternTransform="rotate(45)"
        >
          <rect width="8" height="8" style="fill: var(--color-bg-primary);"></rect>
          <path
            d="M0 0 L0 8"
            style="stroke: var(--color-tab-secondary); stroke-width: 2; opacity: 0.4;"></path>
          <path
            d="M4 0 L4 8"
            style="stroke: var(--color-tab-secondary); stroke-width: 2; opacity: 0.4;"></path>
        </pattern>
      </defs>
    </svg>
    <Navbar transition:persist />
    <main class="pt-16 flex-grow mb-16 pb-16 md:pb-0">
      <slot />
    </main>
    <Footer transition:persist />
  </body>
</html>
