---
import type { SanityDocument } from '@sanity/client';
import { sanityClient } from 'sanity:client';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import HorizontalArticles from '../components/HorizontalArticles.astro';
import heroSantier from '../assets/hero-santier.jpg';
import urlForImage from '../utils/sanityImageUrl';
import { corpBCompletionDate, worksStarted } from '../config/buildings.ts';
import { formatLongDate } from '../utils/formatDate.ts';

const corpBCompletion = formatLongDate(corpBCompletionDate);

// Older posts predate the `building` field and are all about Corp A, so anything not marked
// Corp B belongs to Corp A.
const query = `{
  "corpA": *[_type == "newsPost" && defined(slug.current) && coalesce(building, "corp-a") != "corp-b"]
    |order(date desc)[0...12]{_id, title, slug, date, text, image},
  "corpB": *[_type == "newsPost" && defined(slug.current) && building == "corp-b"]
    |order(date desc)[0...12]{_id, title, slug, date, text, image}
}`;

const { corpA, corpB } = await sanityClient.fetch<{
  corpA: SanityDocument[];
  corpB: SanityDocument[];
}>(query);

// Cards are titled with the post's month and year; the post text is the card body.
const toArticles = (posts: SanityDocument[], building: string) =>
  posts.map((post) => {
    const title = new Date(post.date).toLocaleString('ro-RO', { month: 'long', year: 'numeric' });
    return {
      ...post,
      imageUrl: post?.image
        ? urlForImage(post.image)?.auto('format').width(600).height(400).url()
        : null,
      imageAlt: post.image?.alt || `Stadiul șantierului Nosto, ${building}, ${title}`,
      title,
      text: post.text,
    };
  });

const timelines = [
  { id: 'corp-a', title: 'Corp A', articles: toArticles(corpA, 'Corp A') },
  { id: 'corp-b', title: 'Corp B', articles: toArticles(corpB, 'Corp B') },
].filter((timeline) => timeline.articles.length > 0);
---

<Layout
  title="Stadiul șantierului | Nosto Timișoara"
  description={`Stadiul lucrărilor la Nosto, Timișoara: Corp A este finalizat, iar Corp B are termen de finalizare ${corpBCompletion}. Fotografii și noutăți de pe șantier.`}
>
  <section id="hero" class="section-x-padding py-8">
    <div class="w-full h-[300px] relative overflow-hidden rounded-tr-[6rem]">
      <Image
        src={heroSantier}
        alt="Muncitori în echipament de protecție pe schelă, sub o macara, pe șantier"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 flex items-center justify-center bg-opacity-30">
        <h2 class="font-medium text-center">Stadiu Șantier</h2>
      </div>
    </div>
    <p class="pt-8 text-justify">
      Lucrările au început în {worksStarted}. Corp A este finalizat și aproape complet vândut: au
      mai rămas disponibile doar câteva apartamente. Corp B este în construcție, cu termen de
      finalizare {corpBCompletion}.
    </p>
  </section>

  {
    timelines.map((timeline) => (
      <>
        <SectionTitle title={timeline.title} id={`timeline-${timeline.id}-title`} />
        <HorizontalArticles
          articles={timeline.articles}
          sectionId={`timeline-${timeline.id}`}
          sectionClass="md:overflow-x-visible"
          containerClass="pl-6 md:pl-[70px]"
        />
      </>
    ))
  }
</Layout>
