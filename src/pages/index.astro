---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import heroImage from '../assets/hero-img-min.png';
import corpAPhoto from '../assets/corp-a-new.jpg';
import heroLogo from '../assets/hero-logo-ded.svg';
import tipStudio from '../assets/apartmentTypes/tip_studio.jpg';
import tip15 from '../assets/apartmentTypes/tip_1_5.jpg';
import tip2cam from '../assets/apartmentTypes/tip_2cam.jpg';
import tip25 from '../assets/apartmentTypes/tip_2_5.jpg';
import tip3cam from '../assets/apartmentTypes/tip_3cam.jpg';
import tip4cam from '../assets/apartmentTypes/tip_4cam.jpg';
import Location from '../components/Location.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ApartmentShowcase from '../components/ApartmentShowcase.astro';
import Finish from '../components/Finish.astro';
import { techDetails } from '../config/techDetails.ts';
import YoutubePlayer from '../components/YoutubePlayer.astro';
import BuildingStatus from '../components/BuildingStatus.astro';
import { apartmentTypes, homeHeading, overview, type ApartmentTypeKey } from '../config/home.ts';

const planImages: Record<ApartmentTypeKey, ImageMetadata> = {
  studio: tipStudio,
  '1.5': tip15,
  '2': tip2cam,
  '2.5': tip25,
  '3': tip3cam,
  '4': tip4cam,
};

// Same widths/quality/format as the hero <Image> below, so these resolve to the
// exact same generated files and the preload is a hit rather than a second
// download.
const HERO_WIDTHS = [768, 1200, 1440];
const HERO_SIZES = '100vw';
const heroPreload = await getImage({
  src: heroImage,
  widths: HERO_WIDTHS,
  sizes: HERO_SIZES,
  format: 'webp',
  quality: 75,
});
---

<Layout
  title="Apartamente noi Timișoara, direct de la dezvoltator | Nosto"
  description="Apartamente noi în Timișoara, direct de la dezvoltator: studio, 2, 3 și 4 camere în cartierul liniștit Plopi, la 8 minute de centru. Corp A este finalizat."
  markdownAlternate="/index.md"
  preloadImage={{
    href: heroPreload.src,
    imagesrcset: heroPreload.srcSet.attribute,
    imagesizes: HERO_SIZES,
  }}
>
  <!-- Hero Section -->
  <section id="about" class="relative h-screen w-full overflow-hidden">
    <h1 class="sr-only">{homeHeading}</h1>
    <Image
      src={heroImage}
      alt="Randare a ansamblului rezidențial Nosto din Timișoara: fațada cu balcoane și curtea interioară amenajată, la apus"
      class="w-full h-full object-cover object-center"
      widths={HERO_WIDTHS}
      sizes={HERO_SIZES}
      format="webp"
      quality={75}
      loading="eager"
      fetchpriority="high"
    />
    <Image
      src={heroLogo}
      alt="Nosto – proiect rezidențial în Timișoara"
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
    />
  </section>

  <!-- Corp A / Corp B status -->
  <SectionTitle title="Două corpuri, un singur ansamblu" id="corpuri-title" class="pt-8" />
  <BuildingStatus />

  <SectionTitle title="Prezentarea generală a proiectului" id="despre-proiect-title" class="pt-8" />
  <section id="despre" class="section-x-padding bg-main pt-8">
    <div class="flex flex-col md:flex-row md:items-center gap-8">
      <div class="md:w-1/2">
        <Image
          src={corpAPhoto}
          alt="Corpul A al ansamblului Nosto din Timișoara, finalizat, cu balcoane și grădină cu gazon"
          class="shadow-lg w-full h-auto object-cover"
          width={600}
        />
      </div>

      <div class="md:w-1/2 flex flex-col gap-4">
        {overview.paragraphs.map((paragraph) => <p class="indent-12">{paragraph}</p>)}

        <ul class="space-y-2">
          {
            overview.highlights.map((highlight) => (
              <li class="flex items-center">
                <span class="w-6 h-6 mr-2">✓</span>
                {highlight}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Apartments Section -->
  <section class="pt-12 pb-0 bg-main">
    <SectionTitle title="Tipuri de Apartamente" id="apartamente-title" />
    <div class="max-w-[95vw] lg:max-w-[1600px] mx-auto px-2 sm:px-6 lg:px-8">
      <ApartmentShowcase
        apartments={apartmentTypes.map((apartment) => ({
          ...apartment,
          planImage: planImages[apartment.key],
        }))}
      />
    </div>
  </section>

  <!-- Packages Section -->
  <section id="finisaje" class="pb-12 pt-0 bg-main w-full">
    <SectionTitle title="Pachete Finisaje și dotări" id="finisaje-title" />
    <Finish />
    <!-- TODO: Add Dotari component -->
    <!-- <Dotari /> -->
  </section>

  <SectionTitle title="Listă detalii tehnice" id="tech-title" />
  <section id="tech" class="section-x-padding bg-main py-8">
    <div class="max-w-[95vw] lg:max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          techDetails.map((detail: { title: string; value: string }) => (
            <div class="p-6">
              <h3 class="font-heading font-light text-xl mb-2 uppercase">{detail.title}</h3>
              <p class="text-lg">{detail.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Location Map Section -->
  <section id="location" class="py-12 bg-main w-full">
    <SectionTitle title="Locație si mobilitate" id="location-title" />
    <div class="px-8 md:px-16">
      <div class="mb-8 max-w-4xl mx-auto">
        <YoutubePlayer />
      </div>
      <Location />
    </div>
  </section>
</Layout>
